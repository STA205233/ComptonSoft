<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://raw.githubusercontent.com/odakahirokazu/ComptonSoft/master/xmlstyle/detector_configuration_v6.xsl" ?>

<!--
  NanoGRAMS detector unit for real data (RealDetectorUnitNanoGRAMS).
  - one detector = the whole anode (16 x 16 pixels); the sections are fixed in the code (section = FEC, 64 channels each),
    so no sections node is needed.
  - readout module ID = FEC index (0-3); it is used as ReadoutModuleID of the hits
    (e.g., by the per-FEC energy correction factor in the event reconstruction).
-->
<configuration>
  <name>NanoGRAMS LArTPC</name>
  <comment>2026-09-24 | NanoGRAMS pipeline on RealDetectorUnitNanoGRAMS</comment>
  <length_unit>cm</length_unit>
  <detectors>
    <detector id="0" type="NanoGRAMS" name="NanoGRAMS:0">
      <geometry x="5.12" y="5.12" z="10.0" />
      <offset x="0.0" y="0.0" z="0.0" />
      <pixel number_x="16" number_y="16" size_x="0.32" size_y="0.32" />
      <position x="0.0" y="0.0" z="0.0" />
      <xaxis_direction x="+1.0" y="0.0"  z="0.0" />
      <yaxis_direction x="0.0"  y="+1.0" z="0.0" />
      <zaxis_direction x="0.0"  y="0.0" z="+1.0" />
    </detector>
  </detectors>
  <readout>
    <module id="0">
      <section detector_id="0" section="0" />
    </module>
    <module id="1">
      <section detector_id="0" section="1" />
    </module>
    <module id="2">
      <section detector_id="0" section="2" />
    </module>
    <module id="3">
      <section detector_id="0" section="3" />
    </module>
  </readout>
  <groups>
    <group name="Any">
      <detector id="0" />
    </group>
    <hit_pattern name="1hit" short_name="1hit" bit="0">
      <group name="Any" />
    </hit_pattern>
    <hit_pattern name="2hit" short_name="2hit" bit="1">
      <group name="Any" /><group name="Any" />
    </hit_pattern>
    <hit_pattern name="3hit" short_name="3hit" bit="2">
      <group name="Any" /><group name="Any" /><group name="Any" />
    </hit_pattern>
    <hit_pattern name="4hit" short_name="4hit" bit="3">
      <group name="Any" /><group name="Any" /><group name="Any" /><group name="Any" />
    </hit_pattern>
  </groups>
</configuration>
